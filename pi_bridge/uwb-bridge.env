# Broker
MQTT_HOST=192.168.1.110
MQTT_PORT=1883
MQTT_TOPIC_ROOT=buoy/uwb/ranging
#MQTT_USER=
#MQTT_PASS=

# Tag / serial
UWB_PORT=/dev/serial0
UWB_BAUD=115200
UWB_SOURCE=buoy
UWB_ANCHORS=/opt/uwb/uwb_anchors.json
# Leave unset to read the label from the tag itself via `si`
#UWB_TAG_LABEL=T05
# Update rate, units of 100ms: 1 = 10Hz, 10 = 1Hz
UWB_RATE=1
